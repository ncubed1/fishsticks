{
  "name": "api",
  "version": "1.0.0",
  "description": "api",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "start": "vite --port 4000",
    "lint": "eslint -c .eslintrc.js src --ext ts --ext tsx",
    "serve": "vite preview",
    "test": "npm run test:compile",
    "test:compile": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "import": "./index.ts"
    }
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mathjs": "^14.9.1",
    "pixi.js": "^8.5.2"
  },
  "devDependencies": {
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@fishsticks/config": "*",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.10.4",
    "@types/mathjs": "^9.4.1",
    "@types/node": "^25.3.2",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.26.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5",
    "vite": "^6.4.1",
    "vite-plugin-top-level-await": "^1.3.0",
    "vite-plugin-wasm": "^3.2.1",
    "vitest": "^4.0.18"
  }
